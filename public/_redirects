# Cloudflare Pages redirects. Format: [source] [destination] [code]
# Copied verbatim from public/ to the root of dist/ at build time.
#
# Astro is configured with `trailingSlash: 'always'` and directory-format
# output, and Cloudflare Pages already normalises /page.html -> /page and
# /page/index.html -> /page/, so no rules are needed for that.
#
# Legacy paths emitted by @astrojs/sitemap before finalize-sitemap.mjs runs locally
/sitemap-index.xml /sitemap.xml 301
/sitemap-0.xml /sitemap.xml 301
