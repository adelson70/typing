# Cloudflare Pages custom headers.
# Copied verbatim from public/ to the root of dist/ at build time.

# Fingerprinted build assets — the filename changes whenever the content does,
# so these are safe to cache permanently.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are also fingerprinted.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must never be cached, or visitors get stuck on an old
# version and stop receiving updates.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# HTML must revalidate so content and metadata updates go live immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
