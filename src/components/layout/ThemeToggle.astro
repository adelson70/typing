---
/**
 * Light/dark toggle.
 *
 * A plain button with a small inline script rather than a React island — this
 * sits in the header of every page, so a framework runtime here would be paid
 * for site-wide to flip one attribute.
 */
import { THEME_STORAGE_KEY } from '@/constants/storage';
import { t } from '@/i18n/translations';
import type { Locale } from '@/constants/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class="grid size-10 place-items-center rounded-md text-fg-muted transition-colors duration-fast hover:bg-surface-raised hover:text-fg"
  aria-label={t(locale, 'a11y.toggleTheme')}
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
    class="hidden dark:block"
    data-icon="sun"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    data-icon="moon"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
  (() => {
    /** Resolves what the page is *currently* showing, including the OS default. */
    const currentTheme = () => {
      const explicit = document.documentElement.dataset.theme;
      if (explicit === 'light' || explicit === 'dark') return explicit;
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    };

    const syncIcons = () => {
      const isDark = currentTheme() === 'dark';
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        const sun = button.querySelector('[data-icon="sun"]');
        const moon = button.querySelector('[data-icon="moon"]');
        // Show the icon for the theme the user would switch *to*.
        if (sun instanceof SVGElement) sun.style.display = isDark ? 'block' : 'none';
        if (moon instanceof SVGElement) moon.style.display = isDark ? 'none' : 'block';
      });
    };

    const bind = () => {
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        if (button.dataset.bound === '1') return;
        button.dataset.bound = '1';
        button.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem(storageKey, next);
          } catch {
            /* storage unavailable — the choice still applies for this page */
          }
          syncIcons();
        });
      });
      syncIcons();
    };

    bind();
    // Re-bind after client-side navigation.
    document.addEventListener('astro:page-load', bind);
  })();
</script>
