---
/**
 * Global navigation.
 *
 * Pure HTML/CSS: the mobile menu uses `<details>` rather than a React island,
 * so navigation costs zero JavaScript and works before hydration — the thing
 * that most often breaks a Lighthouse score on content sites.
 */
import { localizedPath, type Locale } from '@/constants/i18n';
import { t } from '@/i18n/translations';
import { SITE_NAME } from '@/constants/site';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const NAV: readonly { key: string; labelKey: Parameters<typeof t>[1] }[] = [
  { key: 'typing-test', labelKey: 'nav.typingTest' },
  { key: 'typing-lessons', labelKey: 'nav.lessons' },
  { key: 'programming-typing', labelKey: 'nav.programming' },
  { key: 'typing-games', labelKey: 'nav.games' },
  { key: 'achievements', labelKey: 'xp.achievements' },
  { key: 'statistics', labelKey: 'nav.statistics' },
  { key: 'blog', labelKey: 'nav.blog' },
];

const currentPath = Astro.url.pathname;

const isActive = (key: string): boolean => {
  const target = localizedPath(locale, key);
  return currentPath === target || currentPath.startsWith(target);
};
---

<header
  class="sticky top-0 z-50 border-b border-border bg-canvas/85 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70"
>
  <div class="container-page flex h-16 items-center gap-4">
    <a
      href={localizedPath(locale, '')}
      class="flex shrink-0 items-center gap-2 font-semibold tracking-tight text-fg"
      aria-label={`${SITE_NAME} — ${t(locale, 'nav.home')}`}
    >
      {/* The keycap mark, matching the favicon. Inline SVG rather than an
          <img> so it needs no extra request and inherits the theme. */}
      <svg
        width="32"
        height="32"
        viewBox="0 0 32 32"
        class="shrink-0"
        aria-hidden="true"
      >
        <rect width="32" height="32" rx="8" class="fill-energy" />
        <rect y="0" width="32" height="25" rx="8" class="fill-ember-300" />
        <rect x="15" y="8" width="2.5" height="12" rx="1.25" class="fill-canvas" />
        <rect x="10" y="20" width="12" height="2.5" rx="1.25" class="fill-canvas" opacity="0.75" />
      </svg>
      <span class="hidden sm:inline">{SITE_NAME}</span>
    </a>

    {/* Centre zone takes the remaining width so the nav sits in a stable
        position regardless of how wide the brand or controls render. */}
    <nav class="hidden flex-1 justify-center lg:flex" aria-label="Main">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={localizedPath(locale, item.key)}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors duration-fast',
                  isActive(item.key)
                    ? 'bg-surface-raised text-fg'
                    : 'text-fg-muted hover:bg-surface-raised hover:text-fg',
                ]}
                aria-current={isActive(item.key) ? 'page' : undefined}
              >
                {t(locale, item.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1 lg:ml-0">
      <ThemeToggle locale={locale} />
      <LocaleSwitcher locale={locale} />

      {/* Mobile menu — no JavaScript required. */}
      <details class="group relative lg:hidden">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-md text-fg-muted transition-colors hover:bg-surface-raised hover:text-fg [&::-webkit-details-marker]:hidden"
          aria-label={t(locale, 'nav.openMenu')}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden" />
            <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block" />
          </svg>
        </summary>

        <nav
          class="absolute right-0 top-12 w-56 rounded-xl border border-border bg-surface p-2 shadow-lg"
          aria-label="Mobile"
        >
          <ul class="flex flex-col">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={localizedPath(locale, item.key)}
                    class:list={[
                      'block rounded-md px-3 py-2.5 text-sm font-medium transition-colors',
                      isActive(item.key)
                        ? 'bg-surface-raised text-fg'
                        : 'text-fg-muted hover:bg-surface-raised hover:text-fg',
                    ]}
                    aria-current={isActive(item.key) ? 'page' : undefined}
                  >
                    {t(locale, item.labelKey)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
