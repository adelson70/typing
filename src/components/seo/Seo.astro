---
/**
 * The single source of every `<head>` tag on every page.
 *
 * Pages never hand-write meta tags — they pass `SeoMeta` and receive canonical,
 * hreflang, Open Graph, Twitter, robots and language tags derived from one
 * route key. This is what guarantees "no duplicated metadata" across a site
 * that will grow to hundreds of pages.
 */
import { Font } from 'astro:assets';

import {
  SITE_NAME,
  TWITTER_HANDLE,
  DEFAULT_OG_IMAGE,
  THEME_COLOR_DARK,
  THEME_COLOR_LIGHT,
  absoluteUrl,
} from '@/constants/site';
import {
  LOCALES,
  LOCALE_TAGS,
  OG_LOCALES,
  DEFAULT_LOCALE,
  localizedPath,
} from '@/constants/i18n';
import type { SeoMeta } from '@/types/seo';

type Props = SeoMeta;

const {
  title,
  description,
  routeKey,
  locale,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  keywords,
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  availableLocales = LOCALES,
} = Astro.props;

const canonical = absoluteUrl(localizedPath(locale, routeKey));
const ogImageUrl = absoluteUrl(ogImage);

// Title is used verbatim if it already carries the brand, otherwise suffixed.
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const alternates = availableLocales.map((alt) => ({
  hreflang: LOCALE_TAGS[alt],
  href: absoluteUrl(localizedPath(alt, routeKey)),
}));

const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />

{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="author" content={author ?? SITE_NAME} />

{/* Language + hreflang. x-default points at the default locale. */}
<meta http-equiv="content-language" content={LOCALE_TAGS[locale]} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link
  rel="alternate"
  hreflang="x-default"
  href={absoluteUrl(localizedPath(DEFAULT_LOCALE, routeKey))}
/>

{/* Open Graph */}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={OG_LOCALES[locale]} />
{
  availableLocales
    .filter((alt) => alt !== locale)
    .map((alt) => <meta property="og:locale:alternate" content={OG_LOCALES[alt]} />)
}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={title} />

{/* Theme + PWA */}
<meta name="theme-color" content={THEME_COLOR_LIGHT} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLOR_DARK} media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="dark light" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={SITE_NAME} />
<meta name="format-detection" content="telephone=no" />

<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

{/* Self-hosted fonts, preloaded — no render-blocking third-party request. */}
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-jetbrains-mono" />
