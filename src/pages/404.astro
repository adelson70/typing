---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import { t } from '@/i18n/translations';
import { localizedPath } from '@/constants/i18n';
import { LANDING_PAGES } from '@/data/pages';

const locale = 'en' as const;

// A 404 that offers real destinations recovers sessions that would otherwise
// bounce, and keeps crawlers moving through the link graph.
const suggestions = LANDING_PAGES.filter((page) =>
  ['typing-test', 'typing-lessons', 'programming-typing', 'daily-challenge'].includes(page.key),
);
---

<BaseLayout
  title="Page Not Found — Typing Studio"
  description="The page you are looking for does not exist or has moved."
  routeKey="404"
  locale={locale}
  noindex={true}
>
  <div class="py-12 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-4xl font-bold">{t(locale, 'error.notFound')}</h1>
    <p class="mx-auto mt-4 max-w-lg text-fg-muted">{t(locale, 'error.notFoundBody')}</p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-accent-fg"
    >
      {t(locale, 'error.backHome')}
    </a>
  </div>

  <ul class="mx-auto mt-12 grid max-w-4xl gap-4 sm:grid-cols-2">
    {
      suggestions.map((page) => (
        <li>
          <Card href={localizedPath(locale, page.key)} padding="md" class="h-full">
            <h2 class="font-medium text-fg">{page.content[locale].h1}</h2>
            <p class="mt-2 text-sm text-fg-muted">{page.content[locale].description}</p>
          </Card>
        </li>
      ))
    }
  </ul>
</BaseLayout>
