{
  // Static Astro site on Cloudflare Workers (assets), same pattern as qrcodehub / flags.
  // `name` must match the Worker in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typing",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist"
  }
}
